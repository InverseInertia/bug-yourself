# Template: server/install.sh fills in @REPO@ and @PYTHON@ and installs it to
# ~/.config/systemd/user/. Your settings live in ~/.config/bug-yourself/receiver.env.
[Unit]
Description=bug-yourself receiver (uploads from the phone)

[Service]
EnvironmentFile=%h/.config/bug-yourself/receiver.env
ExecStart=@PYTHON@ @REPO@/server/receiver.py serve \
    --bind ${BUG_BIND} --port ${BUG_PORT} \
    --dir ${BUG_DIR} --unanalyzed-dir ${BUG_UNANALYZED_DIR} \
    $BUG_EXTRA_ARGS
# Binding to the Tailscale IP fails until Tailscale is up after boot; just retry.
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
